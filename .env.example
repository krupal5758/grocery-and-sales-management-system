PORT=3000

# Required in production. Used to sign JWT auth tokens — use a long random value.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-this-to-a-random-secret

# Optional. If set, an "admin" user is seeded on first run with this password.
# If left unset, no admin is created and the FIRST user to register becomes admin.
# ADMIN_PASSWORD=
